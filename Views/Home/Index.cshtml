<style>
    /* Efeito Hover para os ícones sociais */
    .social-header-icons .search-toggle-btn:hover {
        color: #ffbd59 !important;       /* Muda a cor do ícone */
        border-color: #ffbd59 !important; /* Muda a cor da borda (se houver) */
    }

    /* Garantia extra: força o ícone dentro do botão a pegar a cor */
    .social-header-icons .search-toggle-btn:hover i {
        color: #ffbd59 !important;
    }
    /* Defina um tamanho fixo para o container da imagem se ainda não tiver */
    .image-1{
        width: 711px !important; /* ou a largura desejada em % */
        height: 1037px !important; /* ou a altura desejada */
        overflow: hidden !important; /* Garante que nada saia da caixa */
    }

    .image-2{
        width: 620px !important; /* ou a largura desejada em % */
        height: 700px !important; /* ou a altura desejada */
        overflow: hidden !important; /* Garante que nada saia da caixa */
    }

    /* A mágica acontece aqui */
    .image-1 img, 
    .image-2 img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important; /* Isso faz a imagem agir como um "background-size: cover" */
        object-position: center !important; /* Centraliza a imagem */
    }

    #navbar .navbar-nav li a:hover {
        color: #ffbd59 !important;
    }
</style>
