@{
    Layout = "_Layout";
}
<style>
    /* Força a cor preta/escura nos links do menu apenas nesta página */
    #navbar .navbar-nav li a {
        color: #333 !important; /* Use a cor que desejar (ex: preto ou cinza escuro) */
    }

    /* Caso tenha hover, lembre de mudar também */
    #navbar .navbar-nav li a:hover {
        color: #ffbd59 !important;
    }

    .close-form .theme-btn {
        color: #333 !important;         /* Cor do texto */
        border-color: #333 !important;  /* Cor da borda (se tiver) */
    }

    /* Opcional: Efeito Hover para o botão (quando passa o mouse) */
    .close-form .theme-btn:hover {
        background-color: #333 !important;
        color: #fff !important;
    }

    .image-wrap .image img {
        width: 100%;        /* Garante que ocupe a largura da coluna do Bootstrap */
        height: 500px;      /* Define uma altura FIXA para todas */
        object-fit: cover;  /* A mágica: preenche o espaço cortando o excesso sem distorcer */
        
        /* Opcional: Arredondar cantos ou centralizar o foco */
        object-position: center; 
    }
</style>

